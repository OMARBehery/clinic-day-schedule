# Local Postgres (docker compose) or a hosted URL such as Neon.
DATABASE_URL=postgres://clinic:clinic@127.0.0.1:5432/clinic

# IANA time zone used for "selected date" filtering and the schedule UI.
# Instants are stored in UTC. See docs/ARCHITECTURE.md.
CLINIC_TIMEZONE=Africa/Cairo
NEXT_PUBLIC_CLINIC_TIMEZONE=Africa/Cairo
